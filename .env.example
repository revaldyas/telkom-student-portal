# Local development can use Supabase Session Pooler (port 5432).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres
# Vercel/serverless deployments should use Supabase Shared Transaction Pooler (port 6543).
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
DATABASE_POOL_MAX=5
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Added automatically to Vercel projects linked to a Blob store.
BLOB_READ_WRITE_TOKEN=
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_NAME=
