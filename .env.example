# For a persistent Node server without IPv6, copy the Session pooler URL from Supabase Connect.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres
# For serverless deployments, use Supabase Transaction pooler (port 6543) and verify Payload compatibility.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres
DATABASE_POOL_MAX=5
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Added automatically to Vercel projects linked to a Blob store.
BLOB_READ_WRITE_TOKEN=
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
CMS_ADMIN_NAME=
